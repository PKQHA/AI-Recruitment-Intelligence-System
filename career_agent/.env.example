# 环境变量示例文件
#
# 使用方式：
# 1. 将本文件复制为 `.env`
# 2. 填入你自己的 OpenAI API Key
# 3. 如需兼容其他 OpenAI SDK 兼容网关，可额外填写 BASE URL

OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=

# 兼容旧字段写法，二选一即可
# QWEN_API_KEY=
# QWEN_BASE_URL=
# QWEN_MODEL=qwen-plus
# QWEN_EMBEDDING_MODEL=text-embedding-v4

# Invite-code access control
# Keep real invite codes only in your local .env or deployment secret manager.
# Comma-separated list, each code allows INVITE_CODE_MAX_USES successful analyses.
INVITE_CODES=
INVITE_CODE_MAX_USES=2

# Developer/demo unlimited code. Keep the real value in local .env only.
INVITE_DEV_CODE=

# Optional frontend/API settings
CAREER_AGENT_API_URL=http://127.0.0.1:8000/analyze
CAREER_AGENT_ANALYZE_TIMEOUT=600
